{
    "name": "salabanzi/laravel-scaffold",
    "description": "Générateur de scaffold Laravel 5 couches depuis une migration",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Salabanzi",
            "email": "vincent.salabanzi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Salabanzi\\LaravelScaffold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Salabanzi\\LaravelScaffold\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Salabanzi\\LaravelScaffold\\ScaffoldServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
